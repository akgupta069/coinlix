rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profile + mirrored coin balance — only the owner may read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /app/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public code → uid lookup used to resolve a referral code. Anyone
    // signed in can read it (needed to validate a code before claiming);
    // only the owning uid may create their own entry, and it's immutable.
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Referral "claim outbox" — 2-tier. Doc id is `${refereeUid}_L1` or
    // `${refereeUid}_L2`, both keyed off the ORIGINAL signup's uid, so each
    // signup can produce at most one claim per level ever (a repeat write
    // is an update, which only the beneficiary may perform, and only to
    // flip creditedToReferrer). L1 is created by the referee themselves;
    // L2 is forwarded by the L1 referrer ("via") to their own upline, and
    // is only accepted if get() checks prove "via" is genuinely both (a)
    // the L1 doc's referrer and (b) really has that upline uid as their own
    // referredBy — so nobody can forge a credit to an arbitrary account.
    match /referralClaims/{claimId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.refereeUid ||
        request.auth.uid == resource.data.forReferrerUid ||
        request.auth.uid == resource.data.get('viaUid', null)
      );

      allow create: if request.auth != null && (
        (
          request.resource.data.level == 1 &&
          claimId == request.auth.uid + '_L1' &&
          request.resource.data.refereeUid == request.auth.uid &&
          request.resource.data.forReferrerUid != request.auth.uid &&
          request.resource.data.creditedToReferrer == false
        ) || (
          request.resource.data.level == 2 &&
          claimId == request.resource.data.refereeUid + '_L2' &&
          request.resource.data.viaUid == request.auth.uid &&
          request.resource.data.forReferrerUid != request.auth.uid &&
          request.resource.data.creditedToReferrer == false &&
          get(/databases/$(database)/documents/referralClaims/$(request.resource.data.refereeUid + '_L1')).data.forReferrerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referredBy == request.resource.data.forReferrerUid
        )
      );

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.forReferrerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditedToReferrer']) &&
        request.resource.data.creditedToReferrer == true;

      allow delete: if false;
    }

    // Remote config (economy values, feature flags) — read-only for clients.
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
