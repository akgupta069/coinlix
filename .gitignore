# ---------------------------------------------------------------- dependencies
# Restored on a fresh clone with `npm install` (package-lock.json is committed,
# so the other machine gets byte-identical versions).
node_modules/

# --------------------------------------------------------------- build caches
.expo/
.expo-shared/
web-build/
dist/
.firebase/
*.log
npm-debug.*
yarn-error.*

# ------------------------------------------------- android build output
# Everything under these is regenerated by Gradle. The android/ SOURCE (app/src,
# build.gradle, gradle wrapper, manifest edits) IS committed — this project uses
# a non-clean `expo prebuild`, so those native files are hand-edited and must
# survive a clone.
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
android/.kotlin/
android/captures/
*.iml
.idea/

# Machine-specific — each PC writes its own Android SDK path here.
# See README ("Set up on a new PC") for how to recreate it.
android/local.properties

# --------------------------------------------------- release artifacts
# Rebuilt with `gradlew bundleRelease`; the Play Store graphics next to them in
# build/ are NOT ignored because they are hand-made assets, not build output.
build/*.aab
build/*.apk
build/aab_check*/
public/downloads/

# ------------------------------------------------------------ editor / OS
.DS_Store
Thumbs.db
.claude/scheduled_tasks.lock

# ----------------------------------------------------------------- secrets
.env
.env.*

# Signing credentials are NEVER committed, not even to a private repo — a repo
# can be made public, forked or shared by accident, and leaking the upload key
# lets anyone publish an app that Play accepts as ours. Carry these three by
# hand (encrypted drive / password manager) to any new machine; see the
# "Signing key" section of README.md for where each one goes.
*.keystore
android/keystore.properties
keystore-backup/
